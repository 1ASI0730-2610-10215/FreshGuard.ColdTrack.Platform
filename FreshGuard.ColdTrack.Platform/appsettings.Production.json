{
  "ConnectionStrings": {
    "DefaultConnection": "server=%DATABASE_HOST%;port=%DATABASE_PORT%;database=%DATABASE_NAME%;user=%DATABASE_USER%;password=%DATABASE_PASSWORD%;SslMode=Required;Allow User Variables=True"
  },
  "TokenSettings": {
    "Secret": "%JWT_SECRET%",
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "ExpirationHours": 8
  },
  "Database": {
    "InitializeOnStartup": true,
    "SeedDemoData": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://coldtrack-front-web.web.app",
      "https://coldtrack-front-web.firebaseapp.com"
    ]
  },
  "MonitoringThresholds": {
    "MinimumTemperature": 2,
    "MaximumTemperature": 8,
    "MaximumHumidity": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
