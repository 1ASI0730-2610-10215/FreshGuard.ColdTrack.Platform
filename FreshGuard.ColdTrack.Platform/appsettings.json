{
  "TokenSettings": {
    "Secret": "%JWT_SECRET%",
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "ExpirationHours": 8
  },
  "Database": {
    "InitializeOnStartup": true,
    "SeedDemoData": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://coldtrack-front-web.web.app",
      "https://coldtrack-front-web.firebaseapp.com"
    ]
  },
  "MonitoringThresholds": {
    "MinimumTemperature": 2,
    "MaximumTemperature": 8,
    "MaximumHumidity": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
