{
  "TokenSettings": {
    "Secret": "%JWT_SECRET%",
    "Issuer": "%JWT_ISSUER%",
    "Audience": "%JWT_AUDIENCE%",
    "ExpirationHours": 8
  },
  "Database": {
    "InitializeOnStartup": true,
    "SeedDemoData": true
  },
  "MonitoringThresholds": {
    "MinimumTemperature": 2,
    "MaximumTemperature": 8,
    "MaximumHumidity": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
